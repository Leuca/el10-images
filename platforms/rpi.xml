<image>
	<profiles>
		<profile name="MinimalCore" description="Minimal image core packages">
			<requires profile="BootCore"/>
		</profile>
		<profile name="MinimalDiskPi" description="Minimal Disk Image for Raspberry Pi">
			<requires profile="MinimalCore"/>
		</profile>
	</profiles>
	<preferences profiles="MinimalDiskPi">
		<type image="oem" filesystem="xfs" kernelcmdline="console=tty0 quiet rhgb acpi=off" devicepersistency="by-uuid" bootpartition="true" bootpartsize="1000" bootfilesystem="xfs" efipartsize="600" firmware="uefi">
			<bootloader name="grub2" timeout="5"/>
			<size unit="G">5</size>
			<oemconfig>
				<oem-resize>false</oem-resize>
			</oemconfig>
		</type>
	</preferences>
	<packages type="image" patternType="plusRecommended" profiles="MinimalCore">
		<ignore name="dracut-config-rescue"/>
		<ignore name="firewalld"/>
		<ignore name="kernel"/>
		<ignore name="*-firmware"/>
		<ignore name="geolite2-city"/>
		<ignore name="geolite2-country"/>
		<package name="gdisk"/>
		<package name="glibc-langpack-en"/>
	</packages>
</image>
