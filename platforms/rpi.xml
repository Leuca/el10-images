<image>
	<profiles>
		<profile name="MinimalCorePi4" description="Minimal image core packages">
			<requires profile="BootCore"/>
		</profile>
		<profile name="MinimalCorePi5" description="Minimal image core packages">
			<requires profile="BootCore16K"/>
		</profile>
		<profile name="MinimalDiskPi4" description="Minimal Disk Image for Raspberry Pi 4">
			<requires profile="MinimalCorePi4"/>
		</profile>
		<profile name="MinimalDiskPi5" description="Minimal Disk Image for Raspberry Pi 5">
			<requires profile="MinimalCorePi5"/>
		</profile>
	</profiles>
	<preferences profiles="MinimalDiskPi4">
		<type image="oem" filesystem="xfs" kernelcmdline="console=tty0 quiet rhgb acpi=off" devicepersistency="by-uuid" bootpartition="true" bootpartsize="1000" bootfilesystem="xfs" efipartsize="600" firmware="uefi">
			<bootloader name="grub2" timeout="5"/>
			<size unit="G">5</size>
			<oemconfig>
				<oem-resize>false</oem-resize>
			</oemconfig>
		</type>
	</preferences>
	<preferences profiles="MinimalDiskPi5">
		<type image="oem" filesystem="xfs" kernelcmdline="console=tty0 quiet rhgb acpi=off" devicepersistency="by-uuid" bootpartition="true" bootpartsize="1000" bootfilesystem="xfs" efipartsize="600" firmware="uefi">
			<bootloader name="grub2" timeout="5"/>
			<size unit="G">5</size>
			<oemconfig>
				<oem-resize>false</oem-resize>
			</oemconfig>
		</type>
	</preferences>
	<packages type="image" patternType="plusRecommended" profiles="MinimalCorePi4">
		<ignore name="dracut-config-rescue"/>
		<ignore name="firewalld"/>
		<ignore name="kernel"/>
		<ignore name="*-firmware"/>
		<ignore name="geolite2-city"/>
		<ignore name="geolite2-country"/>
		<package name="gdisk"/>
		<package name="glibc-langpack-en"/>
		<package name="rpi-release"/>
		<package name="boot-rpi4-config"/>
	</packages>
	<packages type="image" patternType="plusRecommended" profiles="MinimalCorePi5">
		<ignore name="dracut-config-rescue"/>
		<ignore name="firewalld"/>
		<ignore name="kernel"/>
		<ignore name="*-firmware"/>
		<ignore name="geolite2-city"/>
		<ignore name="geolite2-country"/>
		<package name="gdisk"/>
		<package name="glibc-langpack-en"/>
		<package name="rpi-release"/>
		<package name="boot-rpi5-config"/>
	</packages>
</image>
