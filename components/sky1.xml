<image>
	<profiles>
		<profile name="LiveInstallSky1" description="Live install ISO for CIX Sky1 (Radxa Orion O6N)">
			<requires profile="BootCore"/>
		</profile>
	</profiles>
	<preferences profiles="LiveInstallSky1">
		<type image="iso" publisher="CentOS AltImages SIG" volid="CentOS_Sky1" primary="true" flags="dmsquash"
			filesystem="erofs" erofscompression="lzma,level=9" fscreateoptions="-b 4096"
			firmware="uefi" efifatimagesize="30" kernelcmdline="console=tty0 console=ttyAMA0,115200 quiet rhgb" mediacheck="true"
		>
			<bootloader name="grub2" grub_template="grub.cfg.iso-template" console="console" timeout="60"/>
		</type>
	</preferences>
	<!--
	  Deliberately does not require GNOME-Desktop: that pulls DesktopCommon
	  (firefox, flatpak, multimedia, container-management, print-client,
	  workstation-product), none of which an installer image needs. Measured
	  on CS10 aarch64: the full stack is 3.6 GiB installed against 1.9 GiB
	  for the set below, and the ISO has to stay under GitHub's 2 GiB
	  release asset limit.

	  The gnome-desktop collection stays, because anaconda is run from the
	  live session in graphical mode; fonts and hardware-support stay
	  because the GUI needs glyphs and the board needs firmware.
	-->
	<packages type="iso" patternType="onlyRequired" profiles="LiveInstallSky1">
		<namedCollection name="gnome-desktop"/>
		<namedCollection name="fonts"/>
		<namedCollection name="hardware-support"/>
		<namedCollection name="anaconda-tools"/>
		<package name="anaconda"/>
		<package name="anaconda-install-env-deps"/>
		<package name="anaconda-liveinst"/>
		<!-- anaconda's RDP mode runs a headless gnome-kiosk served by
		     gnome-remote-desktop; only anaconda-install-img-deps pulls them in -->
		<package name="gnome-kiosk"/>
		<package name="gnome-remote-desktop"/>
		<package name="dracut-live"/>
		<package name="glibc-langpack-en"/>
		<package name="isomd5sum"/>
		<package name="kernel"/>
		<package name="kernel-modules"/>
		<package name="kernel-modules-extra"/>
		<package name="livesys-scripts"/>
		<package name="sky1-release"/>
		<!-- enough to inspect the port from a shell -->
		<package name="pciutils"/>
		<package name="usbutils"/>
		<package name="alsa-utils"/>
		<ignore name="dracut-config-rescue"/>
		<ignore name="gfs2-utils"/>
	</packages>
</image>
